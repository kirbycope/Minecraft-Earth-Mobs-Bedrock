{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kirbycope:skewbald_chicken",
      "materials": {
        "default": "entity",
        "legs": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/earth/chicken/skewbald_chicken/skewbald_chicken"
      },
      "geometry": {
        "default": "geometry.kirbycope.chicken"
      },
      "animations": {
        "move": "animation.kirbycope.chicken.move",
        "general": "animation.kirbycope.chicken.general",
        "look_at_target": "animation.kirbycope.shared.look_at_target",
        "baby_transform": "animation.kirbycope.chicken.baby_transform",
        "blink": "controller.animation.kirbycope.shared.mob_blink"
      },
      "scripts": {
        "animate": [
          "general",
          {
            "move": "query.modified_move_speed"
          },
          "look_at_target",
          {
            "baby_transform": "query.is_baby"
          },
          "blink"
        ],
        "initialize": [
          "variable.is_blinking = 0;",
          "variable.return_from_blink = 0;",
          "variable.last_blink_time = 0;",
          "variable.max_blink_time = 0.3;",
          "variable.min_blink_rest = 3;",
          "variable.max_blink_rest = 40;"
        ],
        "pre_animation": [
          "variable.wing_flap = query.is_on_ground ? 0 : ((math.sin(query.life_time * 1700) + 1) * 0.5);"
        ]
      },
      "render_controllers": [
        "controller.render.kirbycope.genoa_chicken"
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 0
      }
    }
  }
}
