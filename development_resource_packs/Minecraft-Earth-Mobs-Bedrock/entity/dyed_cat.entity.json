{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kirbycope:dyed_cat",
      "materials": {
        "default": "cat"
      },
      "textures": {
        "default": "textures/entity/dyed_cat"
      },
      "geometry": {
        "default": "geometry.cat"
      },
      "animations": {
        "sneak": "animation.cat.sneak",
        "walk": "animation.cat.walk",
        "sprint": "animation.cat.sprint",
        "sit": "animation.cat.sit",
        "look_at_target": "animation.common.look_at_target",
        "lie_down": "animation.cat.lie_down",
        "look_at_controller": "controller.animation.cat.look_at_target",
        "move_controller": "controller.animation.cat.move"
      },
      "scripts": {
        "animate": [
          "look_at_controller",
          "move_controller"
        ],
        "pre_animation": [
          "variable.state = query.is_sitting ? 2 : (query.is_sneaking ? 0 : (query.modified_move_speed > 0.8 ? 1 : 3));",
          "variable.liedownamount = query.is_sleeping ? 1 : 0;",
          "variable.liedownamounttail = query.is_sleeping ? 1 : 0;",
          "variable.lieonplayer = 0;"
        ],
        "scale": "1.25"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#7d5aa6",
        "overlay_color": "#3b2a52"
      }
    }
  }
}
