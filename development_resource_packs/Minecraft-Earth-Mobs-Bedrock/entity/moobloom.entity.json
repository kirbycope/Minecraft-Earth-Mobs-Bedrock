{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kirbycope:moobloom",
      "materials": {
        "default": "cow",
        "flowers": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/earth/cow/moo_bloom/moo_bloom"
      },
      "geometry": {
        "default": "geometry.kirbycope.moo_bloom"
      },
      "animations": {
        "setup": "animation.kirbycope.moo_bloom.setup",
        "walk": "animation.kirbycope.quadruped.walk",
        "look_at_target": "animation.kirbycope.common.look_at_target",
        "baby_transform": "animation.kirbycope.moo_bloom.baby_transform",
        "blink": "controller.animation.kirbycope.moo_bloom.blink"
      },
      "scripts": {
        "animate": [
          "setup",
          {
            "walk": "query.modified_move_speed"
          },
          "look_at_target",
          {
