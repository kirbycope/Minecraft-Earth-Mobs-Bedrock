          },
          "blink"
        ],
        "initialize": [
          "variable.is_blinking = 0;",
          "variable.return_from_blink = 0;",
          "variable.last_blink_time = 0;"
        ]
      },
      "render_controllers": [
        "controller.render.kirbycope.moo_bloom"
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 1
      }
    }
  }
}
