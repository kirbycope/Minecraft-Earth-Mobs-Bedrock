{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kirbycope:fancy_chicken",
      "materials": {
        "default": "entity",
        "alpha": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/earth/chicken/fancy_chicken/fancy_chicken"
      },
      "geometry": {
        "default": "geometry.kirbycope.fancy_chicken"
      },
      "animations": {
        "move": "animation.kirbycope.fancy_chicken.move",
        "general": "animation.kirbycope.chicken.general",
        "look_at_target": "animation.kirbycope.shared.look_at_target",
        "baby_transform": "animation.kirbycope.chicken.baby_transform",
        "blink": "controller.animation.kirbycope.shared.mob_blink",
        "crow": "animation.kirbycope.fancy_chicken.crow",
        "crow_controller": "controller.animation.kirbycope.fancy_chicken.crow"
      },
      "sound_effects": {
        "crow": "mob.fancy_chicken.crow"
      },
      "scripts": {
        "animate": [
          "general",
          {
            "move": "query.modified_move_speed"
          },
          "look_at_target",
          {
            "baby_transform": "query.is_baby"
          },
          "blink",
          "crow_controller"
        ],
        "initialize": [
          "variable.is_blinking = 0;",
          "variable.return_from_blink = 0;",
          "variable.last_blink_time = 0;",
          "variable.max_blink_time = 0.3;",
          "variable.min_blink_rest = 3;",
          "variable.max_blink_rest = 40;",
          "variable.begin_crow = 0;"
        ],
        "pre_animation": [
          "variable.wing_flap = query.is_on_ground ? 0 : ((math.sin(query.life_time * 1700) + 1) * 0.5);"
        ]
      },
      "render_controllers": [
        "controller.render.kirbycope.fancy_chicken"
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 0
      }
    }
  }
}
