{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kirbycope:skeleton_wolf",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/earth/wolf/skeleton_wolf/skeleton_wolf",
        "angry": "textures/entity/earth/wolf/skeleton_wolf/skeleton_wolf_angry"
      },
      "geometry": {
        "default": "geometry.kirbycope.skeleton_wolf"
      },
      "animations": {
        "wolf_howl": "animation.kirbycope.skeleton_wolf.howl",
        "wolf_look_at": "animation.kirbycope.common.look_at_target",
        "wolf_head_rot_z": "animation.kirbycope.wolf.head_rot_z",
        "wolf_tail_default": "animation.kirbycope.skeleton_wolf.tail_default",
        "wolf_angry": "animation.kirbycope.wolf.angry",
        "wolf_shaking": "animation.kirbycope.skeleton_wolf.shaking",
        "wolf_howl_control": "controller.animation.kirbycope.skeleton_wolf.howl",
        "wolf_leg_default": "animation.kirbycope.wolf.leg_default",
        "wolf_setup_control": "controller.animation.kirbycope.wolf.setup",
        "wolf_look_at_control": "controller.animation.kirbycope.wolf.look_at",
        "wolf_head_rot_z_control": "controller.animation.kirbycope.wolf.head_rot_z",
        "wolf_tail_default_control": "controller.animation.kirbycope.wolf.tail_default",
        "wolf_angry_control": "controller.animation.kirbycope.wolf.angry",
        "wolf_shaking_control": "controller.animation.kirbycope.wolf.shaking",
        "blink": "controller.animation.kirbycope.shared_mob.blink"
      },
      "sound_effects": {
        "howl": "mob.skeleton_wolf.howl"
      },
      "scripts": {
        "pre_animation": [
          "variable.leg_shake_x = 0.035;",
          "variable.leg_shake_y = 0.032;",
          "variable.body_shake_angle = 0.05 * query.frame_alpha + query.shake_angle;",
          "variable.body_roll_progress = Math.clamp((variable.body_shake_angle - 0.16) / 1.8, 0, 1);",
          "variable.body_rot_z = Math.sin(variable.body_roll_progress * 180) * Math.sin(variable.body_roll_progress * 1980) * 27;",
          "variable.upper_body_roll_progress = Math.clamp((variable.body_shake_angle - 0.08) / 1.8, 0, 1);",
          "variable.upper_body_rot_z = (Math.sin(variable.upper_body_roll_progress * 180) * Math.sin(variable.upper_body_roll_progress * 1980) * 27) - variable.body_rot_z;",
          "variable.tail_roll_progress = Math.clamp((variable.body_shake_angle - 0.2) / 1.8, 0, 1);",
          "variable.tail_rot_z = (Math.sin(variable.tail_roll_progress * 180) * Math.sin(variable.tail_roll_progress * 1980) * 27);",
          "variable.head_roll_progress = Math.clamp(variable.body_shake_angle / 1.8, 0, 1);",
          "variable.head_rot_z = (Math.sin(variable.head_roll_progress * 180) * Math.sin(variable.head_roll_progress * 1980) * 27);",
          "variable.is_howling = query.property('kirbycope:anim') == 'howl';"
        ],
        "animate": [
          "wolf_look_at_control",
          "wolf_head_rot_z_control",
          "wolf_tail_default_control",
          "wolf_angry_control",
          "wolf_shaking_control",
          "wolf_leg_default",
          "wolf_howl_control",
          "blink"
        ],
        "initialize": [
          "variable.is_howling = 0;",
          "variable.last_blink_time = 0;",
          "variable.is_blinking = 0;",
          "variable.return_from_blink = 0;",
          "variable.max_blink_time = 0.2;",
          "variable.min_blink_rest = 3;",
          "variable.max_blink_rest = 40;"
        ]
      },
      "render_controllers": [
        "controller.render.kirbycope.skeleton_wolf"
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 4
      }
    }
  }
}
