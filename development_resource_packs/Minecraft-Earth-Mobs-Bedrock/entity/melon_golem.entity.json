        "blink": "controller.animation.kirbycope.shared_mob.blink",
        "shot_controller": "controller.animation.kirbycope.melon_golem.shots"
      },
      "sound_effects": {
        "prep": "mob.melon_golem.spit.charge",
        "spit": "mob.melon_golem.spit"
      },
      "scripts": {
        "animate": [
          "blink",
          "shot_controller"
        ],
        "initialize": [
          "variable.is_blinking = 0;",
          "variable.return_from_blink = 0;",
