          "variable.max_blink_rest = 40;",
          "variable.is_attacking = 0;",
          "variable.shots_fired = 0;"
        ],
        "pre_animation": [
          "variable.shots_fired = query.property('kirbycope:anim') == 'attack';"
        ]
      },
      "render_controllers": [
        "controller.render.kirbycope.melon_golem"
      ],
      "spawn_egg": {
        "base_color": "#d9f2f2",
        "overlay_color": "#81a4a4"
      }
    }
  }
