{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kirbycope.mud_pig": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.muddy"
          ]
        },
        "geometries": {
          "Array.geos": [
            "Geometry.default",
            "Geometry.muddy"
          ]
        }
      },
      "geometry": "Array.geos[variable.muddy]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[variable.muddy]"
      ],
      "part_visibility": [
        {
          "face_blink": "variable.is_blinking"
        },
        {
          "face": "!variable.is_blinking"
        }
      ]
    }
  }
}
